FLOCK_API_KEY=
FLOCK_MODEL=gemini-3.1-pro-preview
FLOCK_BASE_URL=https://api.flock.io/v1

# Nansen API — Smart Money + TGM indicators + address labels
# Get from https://app.nansen.ai (Account → API Keys). Free tier works for the demo.
NANSEN_API_KEY=

# Virtuals ACP / OpenClaw ACP
# Run `acp setup` or configure the OpenClaw ACP skill before enabling.
ACP_AUTO_REGISTER=true
ACP_AGENT_NAME_PREFIX=fearnet
ACP_SKILL_DIR=/Users/gryu0603/.codex/skills/openclaw-acp

# Coinbase AgentKit (CDP) — managed server wallet that signs trades for each
# 8004-registered agent. Without these, the app falls back to mock CDP wallets
# that surface in the UI but cannot broadcast real tx.
# Get keys from https://portal.cdp.coinbase.com → API Keys + Wallet Secret.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
CDP_NETWORK_ID=base-sepolia
